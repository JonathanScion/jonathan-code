{
  "name": "db-professor",
  "version": "1.0.0",
  "description": "MCP server for database introspection and English-to-SQL translation",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "db-professor": "./dist/index.js"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "clean": "rimraf dist",
    "typecheck": "tsc --noEmit",
    "prepare": "npm run build"
  },
  "files": [
    "dist",
    "data/.gitkeep"
  ],
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0",
    "mysql2": "^3.11.0",
    "pg": "^8.13.0",
    "sql.js": "^1.11.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/pg": "^8.11.6",
    "@types/sql.js": "^1.4.9",
    "rimraf": "^6.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "database",
    "sql",
    "postgresql",
    "mysql"
  ],
  "license": "MIT"
}
