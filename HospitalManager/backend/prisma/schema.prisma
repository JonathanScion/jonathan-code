generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Simple CRUD ────────────────────────────────────────────

model Department {
  id          Int      @id @default(autoincrement())
  name        String   @unique
  description String?
  phone       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  doctors DoctorDepartment[]
  staff   Staff[]
}

model Room {
  id        Int      @id @default(autoincrement())
  number    String   @unique
  floor     Int
  type      String   // WARD, PRIVATE, ICU, OPERATING, EMERGENCY
  status    String   @default("AVAILABLE") // AVAILABLE, OCCUPIED, MAINTENANCE
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  beds       Bed[]
  admissions Admission[]
}

model Medication {
  id            Int      @id @default(autoincrement())
  name          String
  genericName   String?
  manufacturer  String?
  dosageForm    String   // TABLET, CAPSULE, INJECTION, SYRUP, CREAM, INHALER
  strength      String   // e.g. "500mg", "10mg/5ml"
  price         Decimal  @db.Decimal(10, 2)
  requiresRx    Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  prescriptionItems PrescriptionItem[]
  inventoryItems    InventoryItem[]
}

model InsurancePlan {
  id            Int      @id @default(autoincrement())
  name          String
  provider      String
  type          String   // HMO, PPO, EPO, POS
  coverageLevel String   // BASIC, STANDARD, PREMIUM
  monthlyPremium Decimal @db.Decimal(10, 2)
  deductible    Decimal  @db.Decimal(10, 2)
  maxCoverage   Decimal  @db.Decimal(12, 2)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  patients PatientInsurance[]
}

model Supplier {
  id        Int      @id @default(autoincrement())
  name      String
  contact   String?
  email     String?
  phone     String?
  address   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  inventoryItems InventoryItem[]
}

// ─── Rich Forms ─────────────────────────────────────────────

model Patient {
  id            Int       @id @default(autoincrement())
  // Personal
  firstName     String
  lastName      String
  dateOfBirth   DateTime
  gender        String    // MALE, FEMALE, OTHER
  ssn           String?   @unique
  // Contact
  email         String?
  phone         String?
  address       String?
  city          String?
  state         String?
  zipCode       String?
  // Emergency Contact
  emergencyName  String?
  emergencyPhone String?
  emergencyRelation String?
  // Medical
  bloodType     String?   // A+, A-, B+, B-, AB+, AB-, O+, O-
  allergies     String?
  medicalNotes  String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  insurances  PatientInsurance[]
  appointments Appointment[]
  admissions  Admission[]
  visits      Visit[]
  bills       Bill[]
}

model Doctor {
  id              Int      @id @default(autoincrement())
  // Personal
  firstName       String
  lastName        String
  email           String   @unique
  phone           String?
  // Professional
  licenseNumber   String   @unique
  specialization  String
  yearsExperience Int      @default(0)
  consultationFee Decimal  @db.Decimal(10, 2) @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  departments  DoctorDepartment[]
  appointments Appointment[]
  admissions   Admission[]
  visits       Visit[]
  prescriptions Prescription[]
}

// ─── Parent → Child ─────────────────────────────────────────

model Bed {
  id        Int      @id @default(autoincrement())
  number    String
  type      String   // STANDARD, ELECTRIC, ICU, PEDIATRIC
  status    String   @default("AVAILABLE") // AVAILABLE, OCCUPIED, RESERVED, MAINTENANCE
  roomId    Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  room       Room       @relation(fields: [roomId], references: [id], onDelete: Cascade)
  admissions Admission[]

  @@unique([roomId, number])
}

model InventoryItem {
  id          Int      @id @default(autoincrement())
  supplierId  Int
  medicationId Int?
  name        String
  quantity    Int      @default(0)
  unit        String   // PIECES, BOTTLES, BOXES, VIALS
  reorderLevel Int     @default(10)
  unitCost    Decimal  @db.Decimal(10, 2)
  expiryDate  DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  supplier   Supplier    @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  medication Medication? @relation(fields: [medicationId], references: [id])
}

model Staff {
  id           Int      @id @default(autoincrement())
  firstName    String
  lastName     String
  email        String   @unique
  phone        String?
  role         String   // NURSE, TECHNICIAN, RECEPTIONIST, ADMIN, JANITOR
  departmentId Int
  hireDate     DateTime @default(now())
  salary       Decimal  @db.Decimal(10, 2)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  department Department @relation(fields: [departmentId], references: [id], onDelete: Cascade)
}

// ─── Many-to-Many ───────────────────────────────────────────

model PatientInsurance {
  id            Int      @id @default(autoincrement())
  patientId     Int
  insurancePlanId Int
  policyNumber  String
  startDate     DateTime
  endDate       DateTime?
  isPrimary     Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  patient       Patient       @relation(fields: [patientId], references: [id], onDelete: Cascade)
  insurancePlan InsurancePlan @relation(fields: [insurancePlanId], references: [id], onDelete: Cascade)

  @@unique([patientId, insurancePlanId])
}

model DoctorDepartment {
  id           Int      @id @default(autoincrement())
  doctorId     Int
  departmentId Int
  isPrimary    Boolean  @default(false)
  startDate    DateTime @default(now())
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  doctor     Doctor     @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  department Department @relation(fields: [departmentId], references: [id], onDelete: Cascade)

  @@unique([doctorId, departmentId])
}

// ─── Status Workflow ────────────────────────────────────────

model Appointment {
  id          Int      @id @default(autoincrement())
  patientId   Int
  doctorId    Int
  dateTime    DateTime
  duration    Int      @default(30) // minutes
  type        String   // CONSULTATION, FOLLOW_UP, EMERGENCY, ROUTINE
  status      String   @default("SCHEDULED") // SCHEDULED, CONFIRMED, IN_PROGRESS, COMPLETED, CANCELLED
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  patient Patient @relation(fields: [patientId], references: [id], onDelete: Cascade)
  doctor  Doctor  @relation(fields: [doctorId], references: [id], onDelete: Cascade)
}

model Admission {
  id            Int       @id @default(autoincrement())
  patientId     Int
  doctorId      Int
  roomId        Int
  bedId         Int?
  admitDate     DateTime  @default(now())
  dischargeDate DateTime?
  status        String    @default("ADMITTED") // ADMITTED, DISCHARGED, TRANSFERRED
  reason        String?
  notes         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  patient Patient @relation(fields: [patientId], references: [id], onDelete: Cascade)
  doctor  Doctor  @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  room    Room    @relation(fields: [roomId], references: [id])
  bed     Bed?    @relation(fields: [bedId], references: [id])
}

// ─── Child of Child ─────────────────────────────────────────

model Visit {
  id          Int      @id @default(autoincrement())
  patientId   Int
  doctorId    Int
  visitDate   DateTime @default(now())
  chiefComplaint String?
  vitalSigns  String?  // JSON string: {bp, heartRate, temp, weight}
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  patient       Patient        @relation(fields: [patientId], references: [id], onDelete: Cascade)
  doctor        Doctor         @relation(fields: [doctorId], references: [id])
  diagnoses     Diagnosis[]
  labOrders     LabOrder[]
  prescriptions Prescription[]
}

model Diagnosis {
  id          Int      @id @default(autoincrement())
  visitId     Int
  code        String   // ICD-10 code
  description String
  type        String   // PRIMARY, SECONDARY, DIFFERENTIAL
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  visit Visit @relation(fields: [visitId], references: [id], onDelete: Cascade)
}

// ─── 3-Level Deep ───────────────────────────────────────────

model LabOrder {
  id          Int      @id @default(autoincrement())
  visitId     Int
  testName    String
  category    String   // BLOOD, URINE, IMAGING, BIOPSY, OTHER
  priority    String   @default("ROUTINE") // STAT, URGENT, ROUTINE
  status      String   @default("ORDERED") // ORDERED, IN_PROGRESS, COMPLETED, CANCELLED
  orderedAt   DateTime @default(now())
  completedAt DateTime?
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  visit   Visit       @relation(fields: [visitId], references: [id], onDelete: Cascade)
  results LabResult[]
}

model LabResult {
  id          Int      @id @default(autoincrement())
  labOrderId  Int
  parameter   String
  value       String
  unit        String?
  normalRange String?
  isAbnormal  Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  labOrder LabOrder @relation(fields: [labOrderId], references: [id], onDelete: Cascade)
}

model Prescription {
  id          Int      @id @default(autoincrement())
  visitId     Int
  doctorId    Int
  date        DateTime @default(now())
  notes       String?
  status      String   @default("ACTIVE") // ACTIVE, COMPLETED, CANCELLED
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  visit  Visit              @relation(fields: [visitId], references: [id], onDelete: Cascade)
  doctor Doctor             @relation(fields: [doctorId], references: [id])
  items  PrescriptionItem[]
}

model PrescriptionItem {
  id              Int      @id @default(autoincrement())
  prescriptionId  Int
  medicationId    Int
  dosage          String   // e.g. "500mg"
  frequency       String   // e.g. "twice daily"
  duration        String   // e.g. "7 days"
  quantity        Int
  instructions    String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  prescription Prescription @relation(fields: [prescriptionId], references: [id], onDelete: Cascade)
  medication   Medication   @relation(fields: [medicationId], references: [id])
}

// ─── Computed ───────────────────────────────────────────────

model Bill {
  id          Int       @id @default(autoincrement())
  patientId   Int
  visitId     Int?
  date        DateTime  @default(now())
  dueDate     DateTime?
  totalAmount Decimal   @db.Decimal(12, 2) @default(0)
  paidAmount  Decimal   @db.Decimal(12, 2) @default(0)
  status      String    @default("PENDING") // PENDING, PARTIAL, PAID, OVERDUE, CANCELLED
  notes       String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  patient   Patient        @relation(fields: [patientId], references: [id], onDelete: Cascade)
  lineItems BillLineItem[]
}

model BillLineItem {
  id          Int      @id @default(autoincrement())
  billId      Int
  description String
  category    String   // CONSULTATION, PROCEDURE, MEDICATION, LAB, ROOM, OTHER
  quantity    Int      @default(1)
  unitPrice   Decimal  @db.Decimal(10, 2)
  total       Decimal  @db.Decimal(10, 2)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  bill Bill @relation(fields: [billId], references: [id], onDelete: Cascade)
}
